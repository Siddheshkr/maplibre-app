# Copy this file to .env and fill in the database connection.
# Never put these values in the Angular application.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gisdb
DATABASE_USER=gis_reader
DATABASE_PASSWORD=gis_reader
DATABASE_SSLMODE=prefer

# Comma-separated schemas that contain published spatial tables.
DATABASE_SCHEMAS=gis,public

# Alternatively, set a full DSN and leave the individual values blank:
# DATABASE_URL=postgresql://gis_reader:gis_reader@localhost:5432/gisdb?sslmode=prefer

# Frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Optional tuning.
STATEMENT_TIMEOUT_MS=15000
MAX_FEATURES=2000
DEFAULT_FEATURE_LIMIT=500
LAYER_CACHE_TTL_SECONDS=60
# Omit to make every discovered layer visible by default.
# DEFAULT_VISIBLE_LAYERS=3
STYLE_CONFIG_PATH=config/layer_styles.json
